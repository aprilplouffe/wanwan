# Server port (optional; in dev AI Studio expects port 3000 via DEFAULT_APP_PORT)
PORT=3000

# Official Fish Audio API key (server-side only; never sent to browser clients)
FISH_AUDIO_API_KEY=

# Optional shared proxy access token for anti-abuse protection (recommended for Capacitor / public deployments)
# Clients pass this in X-Fish-Proxy-Token (separate from FISH_AUDIO_API_KEY)
FISH_PROXY_ACCESS_TOKEN=

# Optional comma-separated extra allowed CORS origins (e.g. https://your-domain.com,capacitor://localhost)
FISH_PROXY_ALLOWED_ORIGINS=

# Allow browser-submitted personal API key exchange via HTTPS session endpoint (/api/tts/fish/session)
# Set to 0 to strictly allow only server-managed FISH_AUDIO_API_KEY
FISH_ALLOW_BYOK_SESSION=1

# Per-IP rate limit (requests per minute) and upstream request timeout (ms)
FISH_PROXY_RATE_LIMIT_MAX=30
FISH_PROXY_TIMEOUT_MS=25000
